# Local development defaults — copy to .env and adjust.
# Never commit real secrets.

MEMLORE_ENV=development
MEMLORE_LOG_LEVEL=INFO

# PostgreSQL (governance / control plane)
MEMLORE_POSTGRES_DSN=postgresql://memlore:memlore@localhost:15432/memlore

# Go HTTP server (`go run ./cmd/memlore serve`)
MEMLORE_HTTP_HOST=127.0.0.1
MEMLORE_HTTP_PORT=8080

# Neo4j (knowledge plane)
MEMLORE_NEO4J_URI=bolt://localhost:7687
MEMLORE_NEO4J_USER=neo4j
MEMLORE_NEO4J_PASSWORD=memlore-dev-password

# Graph service (knowledge plane HTTP)
MEMLORE_GRAPH_SERVICE_URL=http://127.0.0.1:8090
OPENAI_API_KEY=

# Outbox worker (`memlore worker`)
MEMLORE_WORKER_POLL_INTERVAL=5s

# Redis (workers / optional caching)
MEMLORE_REDIS_URL=redis://localhost:6379/0
