# Local development defaults — copy to .env and adjust.
# Never commit real secrets.

MEMLORE_ENV=development
MEMLORE_LOG_LEVEL=INFO

# PostgreSQL (governance / control plane)
MEMLORE_POSTGRES_DSN=postgresql+psycopg://memlore:memlore@localhost:15432/memlore

# Neo4j (knowledge plane)
MEMLORE_NEO4J_URI=bolt://localhost:7687
MEMLORE_NEO4J_USER=neo4j
MEMLORE_NEO4J_PASSWORD=memlore-dev-password

# Redis (workers / optional caching)
MEMLORE_REDIS_URL=redis://localhost:6379/0
